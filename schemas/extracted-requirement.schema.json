{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcapture.dev/schemas/extracted-requirement.schema.json",
  "title": "ExtractedRequirement",
  "description": "PRD §8.3 + §10.1 — one structured requirement extracted from a solicitation document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "opportunity_id",
    "type",
    "title",
    "confidence",
    "is_blocker",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "opportunity_id": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "enum": [
        "eligibility",
        "technical",
        "past_performance",
        "certification",
        "insurance",
        "bonding",
        "security",
        "submission",
        "evaluation",
        "deadline",
        "location",
        "pricing",
        "document_required"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "value": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "evidence_snippet": { "type": ["string", "null"] },
    "source_document": { "type": ["string", "null"] },
    "page_number": { "type": ["integer", "null"], "minimum": 1 },
    "is_blocker": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
