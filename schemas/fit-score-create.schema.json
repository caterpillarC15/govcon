{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govcapture.dev/schemas/fit-score-create.schema.json",
  "title": "FitScoreCreate",
  "description": "POST body for creating a FitScore. Server fills id, opportunity_id (from path), and created_at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_profile_id",
    "total_score",
    "decision",
    "confidence",
    "breakdown",
    "strengths",
    "weaknesses",
    "blockers",
    "missing_info"
  ],
  "properties": {
    "company_profile_id": { "type": "string", "format": "uuid" },
    "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "decision": {
      "type": "string",
      "enum": ["strong_pursue", "pursue", "maybe", "reject"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "eligibility",
        "naics",
        "past_performance",
        "certification",
        "insurance_bonding",
        "deadline",
        "complexity",
        "geography"
      ],
      "properties": {
        "capability": { "type": "integer", "minimum": 0, "maximum": 20 },
        "eligibility": { "type": "integer", "minimum": 0, "maximum": 15 },
        "naics": { "type": "integer", "minimum": 0, "maximum": 10 },
        "past_performance": { "type": "integer", "minimum": 0, "maximum": 15 },
        "certification": { "type": "integer", "minimum": 0, "maximum": 10 },
        "insurance_bonding": { "type": "integer", "minimum": 0, "maximum": 10 },
        "deadline": { "type": "integer", "minimum": 0, "maximum": 10 },
        "complexity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "geography": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "missing_info": { "type": "array", "items": { "type": "string" } },
    "recommended_next_action": { "type": ["string", "null"] }
  }
}
