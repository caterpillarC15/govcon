[Unit]
Description=GovCapture FastAPI (gunicorn + UvicornWorker)
Documentation=https://github.com/caterpillarC15/govcon
# v1.2.5: Postgres/Auth/Storage are Supabase-hosted, so no postgresql.service dependency.
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=govcapture
Group=govcapture
WorkingDirectory=/opt/govcapture
EnvironmentFile=/opt/govcapture/.env
# Run the venv's gunicorn directly. We do NOT use `uv run` at runtime because
# uv writes a lockfile to ~/.cache/uv/, which collides with ProtectHome=read-only.
# The venv is created at deploy time by `uv sync` (writes to /opt/govcapture/.venv,
# which is covered by ReadWritePaths below).
Environment=PATH=/opt/govcapture/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 4–8 workers per PRD §7.6 ("scale with vCPU"). Start at 4 on the VX1; bump if needed.
ExecStart=/opt/govcapture/.venv/bin/gunicorn api.main:app \
  --worker-class uvicorn.workers.UvicornWorker \
  --workers 4 \
  --bind 127.0.0.1:8000 \
  --timeout 120 \
  --graceful-timeout 30 \
  --max-requests 1000 \
  --max-requests-jitter 100 \
  --access-logfile - \
  --error-logfile -

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening — non-root, restricted filesystem, no privilege escalation.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# v1.2.5: no /var/lib/govcapture (PDFs and parsed text live in Supabase Storage).
ReadWritePaths=/opt/govcapture
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

# stdout/stderr → journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=govcapture-api

[Install]
WantedBy=multi-user.target
