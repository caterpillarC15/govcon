[Unit]
Description=GovCapture daily backup (pg_dump + parsed-doc tarball)
Documentation=PRD §7.6 "Operational hygiene"
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/govcapture-backup
StandardOutput=journal
StandardError=journal
SyslogIdentifier=govcapture-backup
