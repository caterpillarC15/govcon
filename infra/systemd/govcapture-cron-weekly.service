[Unit]
Description=GovCapture §5.14 weekly opportunity send (curl into FastAPI loopback)
Documentation=PRD §5.14
After=network-online.target govcapture-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=govcapture
Group=govcapture
WorkingDirectory=/opt/govcapture
EnvironmentFile=/opt/govcapture/.env

# Sender is Resend-bound so it scales with the eligible-recipient count.
# 10min ceiling is intentional — at >2k recipients with Resend rate limits
# this can run long. Adjust as the list grows.
ExecStart=/usr/bin/curl --silent --show-error --fail-with-body \
  --connect-timeout 30 \
  --max-time 600 \
  --request POST \
  --header "Authorization: Bearer ${INTERNAL_API_KEY}" \
  --output - \
  http://127.0.0.1:8000/internal/cron/weekly-opportunity-email

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=govcapture-cron-weekly
