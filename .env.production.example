# Copy to /opt/govcapture/.env on the Vultr box. Owned by `govcapture`, mode 0600.
#
#   sudo -u govcapture install -m 0600 /dev/null /opt/govcapture/.env
#   sudo -u govcapture editor /opt/govcapture/.env

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Optional. Live SAM.gov fetches; absent = seeded fixtures only. ---
SAM_API_KEY=

# --- Local services (native Postgres + Redis on the box) ---
# Set the password via:
#   sudo -u postgres psql -c "ALTER USER govcon WITH PASSWORD '...';"
# Then put the same password here, URL-encoded.
DATABASE_URL=postgresql+asyncpg://govcon:CHANGEME@localhost:5432/govcon
REDIS_URL=redis://localhost:6379/0

# --- Hermes runtime ---
HERMES_HOME=/home/govcapture/.hermes
HERMES_MODEL=claude-sonnet-4-6

# --- LLM models (PRD §4.5) ---
LLM_DEV_MODEL=claude-haiku-4-5-20251001
LLM_SYNTH_MODEL=claude-sonnet-4-6

# --- Run budgets (PRD §4.5) ---
RUN_BUDGET_USD=0.50
RUN_BUDGET_STEPS=40
RUN_BUDGET_SECONDS=360

# --- Demo override (PRD §13.1). true = no live SAM calls; reads from /fixtures only. ---
DEMO_USE_SEEDED_ONLY=false
