# Copy to /opt/govcapture/.env on the Vultr box. Owned by `govcapture`, mode 0600.
#
#   sudo -u govcapture install -m 0600 /dev/null /opt/govcapture/.env
#   sudo -u govcapture editor /opt/govcapture/.env

# --- Model transport ---
# Project runtime uses direct Anthropic by default. Do not put OpenRouter keys
# here unless a future model-routing adapter explicitly requires them.
ANTHROPIC_API_KEY=

# --- SAM.gov (optional). Empty = seeded fixtures only. ---
SAM_API_KEY=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# --- Next.js Supabase Auth (/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=https://api.govcapture.example

# --- Redis (native on the box; powers the SSE pub/sub bridge) ---
REDIS_URL=redis://localhost:6379/0

# --- API security / CORS ---
INTERNAL_API_KEY=
CORS_ALLOWED_ORIGINS=https://govcapture.example,https://app.govcapture.example

# --- Hermes runtime ---
# Project-isolated Hermes home. Do not depend on the deploy user's global home.
HERMES_HOME=/opt/govcapture/.hermes
HERMES_MODEL=claude-sonnet-4-6

# --- LLM models (PRD §4.5) ---
LLM_DEV_MODEL=claude-haiku-4-5-20251001
LLM_SYNTH_MODEL=claude-sonnet-4-6

# --- Run budgets (PRD §4.5) ---
RUN_BUDGET_USD=0.50
RUN_BUDGET_STEPS=40
RUN_BUDGET_SECONDS=360

# --- Demo override (PRD §13.1). true = no live SAM calls; reads from /fixtures only. ---
DEMO_USE_SEEDED_ONLY=false
DEMO_REPLAY_TRACE=false
