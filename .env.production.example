# Copy to /opt/govcapture/.env on the Vultr box. Owned by `govcapture`, mode 0600.
#
#   sudo -u govcapture install -m 0600 /dev/null /opt/govcapture/.env
#   sudo -u govcapture editor /opt/govcapture/.env

# PRD v1.2.6: ANTHROPIC_API_KEY removed. Every skill in this repo is
# deterministic; Michaela's bench in /root/michealaai owns LLM calls.

# --- SAM.gov (optional). Empty = seeded fixtures only. ---
SAM_API_KEY=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# --- Next.js Supabase Auth (/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=https://api.govcapture.example

# --- Redis (native on the box; powers the SSE pub/sub bridge) ---
REDIS_URL=redis://localhost:6379/0

# --- API security / CORS ---
INTERNAL_API_KEY=
# CORS_ALLOWED_ORIGINS: comma-separated list of origins allowed to hit the
# API from a browser. MUST include the production landing host AND the
# product-app host — empty (or missing the landing host) silently breaks
# every POST /waitlist with a CORS error in the browser console.
# Vercel preview-deployment regex (*.vercel.app) is appended in main.py.
CORS_ALLOWED_ORIGINS=https://govcapture.example,https://app.govcapture.example

# --- NOT read by this repo (PRD v1.2.5+) ---
# HERMES_HOME / HERMES_MODEL belong to the Michaela orchestrator's own
# environment (it lives in /root/michealaai). If the orchestrator
# deploys to the same VX1 box, give it a separate env file under its
# own working directory rather than mixing into this one.
#
# DEMO_USE_SEEDED_ONLY / DEMO_REPLAY_TRACE were dropped at PRD v1.2.5
# because seeded/demo routing belongs to the orchestrator, not the
# capability pack. The pack still ships seeded fixtures under
# /fixtures and the load_seeded_opportunities skill.

# --- Email delivery: two channels ---
#
# Channel A — Supabase Auth SMTP (magic-link + waitlist confirmation).
# Configured in Supabase Studio → Authentication → Email Templates →
# SMTP Settings. Production uses Resend SMTP:
#
#   Sender email   noreply@<your-domain>
#   Sender name    GovCon Bid Desk
#   Host           smtp.resend.com
#   Port           465  (SSL)
#   Username       resend
#   Password       <Resend API key — sending-access scope only>
#
# Domain DNS (Resend dashboard tells you the exact records):
#   - SPF (TXT)
#   - DKIM (CNAME × 3)
#   - Optional DMARC (TXT, p=none → p=quarantine after deliverability checks)
#
# That key lives in Supabase Studio, NOT in this env file.
#
# Channel B — Weekly Opportunity Email (PRD §5.14, v1.2.6+).
# FastAPI calls the Resend HTTP API directly (Python SDK). Needs a
# separate Resend API key with sending scope, set HERE on the VX1.

# --- Resend (weekly opportunity email — PRD §5.14) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=GovCapture <noreply@<your-domain>>
RESEND_REPLY_TO=

# Public base URL the unsubscribe link points at — must match the
# certbot-issued cert. Mailbox providers refuse unsubscribe links over HTTP.
EMAIL_PUBLIC_BASE_URL=https://api.govcapture.example

# HMAC secret for unsubscribe tokens. Generate fresh: `openssl rand -hex 32`.
# MUST differ from the dev secret.
EMAIL_UNSUBSCRIBE_SECRET=

# CAN-SPAM physical mailing address (required in production).
# api/config.py refuses to start if EMAIL_DRY_RUN=false and this is empty.
EMAIL_LEGAL_FOOTER_ADDRESS=

# Production toggle. Keep `true` until first verified send; flip to `false`
# only after a verified-domain test send lands cleanly.
EMAIL_DRY_RUN=true
EMAIL_REQUIRE_DOUBLE_OPT_IN=false

# Auto-picker (PRD §5.14).
EMAIL_AUTO_PICK_ENABLED=true
EMAIL_AUTO_PICK_MIN_SCORE=60
EMAIL_AUTO_PICK_MAX_CANDIDATES=20
EMAIL_NAICS_ALLOWLIST=
EMAIL_USE_FIXTURES_FOR_AUTO_PICK=false
