# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.eggs/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
.parcel-cache/
*.tsbuildinfo

# Env
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.production.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local artifacts
.playwright-mcp/
*.log

# Supabase CLI — linked-project cache (connection hints; do not commit)
supabase/.temp/

# Claude Code worktrees (each is its own embedded repo on a feature branch;
# never commit them into main — they would land as broken submodule pointers
# at best, or duplicate the entire tree at worst).
.claude/worktrees/

# NOTE: PDF fixtures live under /fixtures/<slug>/attachments/*.pdf and are CONTENT.
# Do NOT add a global *.pdf ignore.

# Hermes runtime artifacts. .hermes/config.yaml + .hermes/skills/ are tracked
# content; the rest is per-developer state created when `hermes` runs against
# HERMES_HOME=$(pwd)/.hermes and should not be committed.
.hermes/SOUL.md
.hermes/cron/
.hermes/logs/
.hermes/memories/
.hermes/sessions/
.hermes/.env
.hermes/auth.json
.hermes/auth.lock
