# =============================================================================
# GovCon — local development (.env template)
# Copy to `.env` at the repo root. For Next-only overrides, use `landing/.env.local`.
# Never commit real secrets.
# =============================================================================

# --- Required (FastAPI / api/config.py) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Supabase (dashboard → Project Settings → API) ---
# Browser-safe only with Row Level Security configured correctly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (optional: routing, embeddings, GPT-family tools; wire in code when used) ---
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Optional. Live SAM.gov fetches; absent = seeded fixtures only. ---
SAM_API_KEY=

# Postgres — Supabase per PRD v1.2.3 §7.5.
# Use the Direct Connection URL (port 5432), NOT the pgBouncer pooler (6543) —
# asyncpg's prepared statements break transaction-mode pooling.
# Get it from: Supabase dashboard → Project → Settings → Database → Direct connection.
# Example: postgresql+asyncpg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# Local-dev fallback: postgresql+asyncpg://govcon@localhost:5432/govcon
DATABASE_URL=

# Native Redis on VX1 in prod; Homebrew/apt locally. Powers the SSE pub/sub bridge.
REDIS_URL=redis://localhost:6379/0

# Supabase project (PRD v1.2.3 §7.5) — server-side aliases / storage.
# SERVICE_ROLE bypasses RLS — server-only, never ship to the web client.
# ANON matches NEXT_PUBLIC anon key when wired for server rendering.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# --- Hermes runtime ---
HERMES_HOME=~/.hermes
HERMES_MODEL=claude-sonnet-4-6

# --- LLM models (PRD §4.5). Haiku dev / Sonnet synthesis ---
LLM_DEV_MODEL=claude-haiku-4-5-20251001
LLM_SYNTH_MODEL=claude-sonnet-4-6

# --- Run budgets (PRD §4.5) ---
RUN_BUDGET_USD=0.50
RUN_BUDGET_STEPS=40
RUN_BUDGET_SECONDS=360

# --- Frontend → backend (Next / landing) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GovCapture Agent

# --- Demo override (PRD §13.1). true = no live SAM; /fixtures only ---
DEMO_USE_SEEDED_ONLY=false
