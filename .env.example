# =============================================================================
# GovCon — local development (.env template)
# Copy to `.env` at the repo root. Never commit real secrets.
# =============================================================================

# --- SAM.gov (optional). Empty = seeded fixtures only. ---
SAM_API_KEY=

# PRD v1.2.6: ANTHROPIC_API_KEY, LLM_DEV_MODEL, LLM_SYNTH_MODEL,
# RUN_BUDGET_USD/STEPS/SECONDS were removed. Every skill in this repo
# is now deterministic; Michaela's bench in /root/michealaai owns LLM
# calls + budget tracking. If your local Hermes still uses Anthropic,
# put ANTHROPIC_API_KEY in ~/.hermes/auth.json (or HERMES_HOME) — not
# here.

# --- Supabase (Project Settings → API) ---
# SERVICE_ROLE bypasses RLS — server-only, never ship to the browser.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# --- Next.js Supabase Auth (/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Public site URLs (read by /landing and /web at build time) ---
# NEXT_PUBLIC_SITE_URL: canonical landing host. Used for og:url, sitemap,
# and the magic-link emailRedirectTo in /web login. Local dev = landing on :3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL: where the landing's "Sign in" / "Get started" CTAs
# point at. Local dev = /web on :3001.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Redis (SSE pub/sub bridge) ---
REDIS_URL=redis://localhost:6379/0

# --- API security / CORS ---
INTERNAL_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Resend (weekly opportunity email — PRD §5.14) ---
# Sandbox-only sends land in the Resend account-owner inbox until a domain is
# verified at resend.com/domains. Default FROM uses the sandbox sender; flip
# to a verified domain before live send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GovCapture <onboarding@resend.dev>
RESEND_REPLY_TO=

# Public base URL the unsubscribe link points at. Local dev = FastAPI on :8000.
EMAIL_PUBLIC_BASE_URL=http://localhost:8000

# HMAC secret for unsubscribe tokens. Generate fresh per env: `openssl rand -hex 32`.
EMAIL_UNSUBSCRIBE_SECRET=

# CAN-SPAM physical mailing address. The job refuses to send in production
# if this is empty. Keep blank in dev — dry-run mode is on.
EMAIL_LEGAL_FOOTER_ADDRESS=

# Cadence + safety toggles.
EMAIL_REQUIRE_DOUBLE_OPT_IN=false
EMAIL_DRY_RUN=true

# Auto-picker (PRD §5.14). LLM ranks candidates against a generic SMB profile;
# hard safety filters drop set-asides we can't verify, deadlines < 14 days,
# clearance/CUI keywords, and non-US performance.
EMAIL_AUTO_PICK_ENABLED=true
EMAIL_AUTO_PICK_MIN_SCORE=60
EMAIL_AUTO_PICK_MAX_CANDIDATES=20
EMAIL_NAICS_ALLOWLIST=
EMAIL_USE_FIXTURES_FOR_AUTO_PICK=false
