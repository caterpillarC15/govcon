# Required
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional. Live SAM.gov fetches; absent = seeded fixtures only.
SAM_API_KEY=

# Postgres — Supabase per PRD v1.2.3 §7.5.
# Use the Direct Connection URL (port 5432), NOT the pgBouncer pooler (6543) —
# asyncpg's prepared statements break transaction-mode pooling.
# Get it from: Supabase dashboard → Project → Settings → Database → Direct connection.
# Example: postgresql+asyncpg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# Local-dev fallback: postgresql+asyncpg://govcon@localhost:5432/govcon
DATABASE_URL=

# Native Redis on VX1 in prod; Homebrew/apt locally. Powers the SSE pub/sub bridge.
REDIS_URL=redis://localhost:6379/0

# Supabase project (PRD v1.2.3 §7.5).
# SERVICE_ROLE bypasses RLS — server-only, never ship to the web client.
# ANON is safe for the browser (RLS-protected; v1.2.3 defers RLS / Auth per §17 Q5).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# Hermes runtime
HERMES_HOME=~/.hermes
HERMES_MODEL=claude-sonnet-4-6

# LLM models. Haiku for dev iteration, Sonnet for synthesis + eval (PRD §4.5).
LLM_DEV_MODEL=claude-haiku-4-5-20251001
LLM_SYNTH_MODEL=claude-sonnet-4-6

# Run budgets (PRD §4.5)
RUN_BUDGET_USD=0.50
RUN_BUDGET_STEPS=40
RUN_BUDGET_SECONDS=360

# Demo override (PRD §13.1). true = no live SAM calls; reads from /fixtures only.
DEMO_USE_SEEDED_ONLY=false
