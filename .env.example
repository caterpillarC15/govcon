# =============================================================================
# GovCon — local development (.env template)
# Copy to `.env` at the repo root. Never commit real secrets.
# =============================================================================

# --- Model transport ---
# Project runtime uses direct Anthropic by default. Do not put OpenRouter keys
# here unless a future model-routing adapter explicitly requires them.
ANTHROPIC_API_KEY=

# --- SAM.gov (optional). Empty = seeded fixtures only. ---
SAM_API_KEY=

# --- Supabase (Project Settings → API) ---
# SERVICE_ROLE bypasses RLS — server-only, never ship to the browser.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=govcapture-attachments

# --- Next.js Supabase Auth (/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Redis (SSE pub/sub bridge) ---
REDIS_URL=redis://localhost:6379/0

# --- API security / CORS ---
INTERNAL_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- LLM models (PRD §4.5) ---
LLM_DEV_MODEL=claude-haiku-4-5-20251001
LLM_SYNTH_MODEL=claude-sonnet-4-6

# --- Run budgets (PRD §4.5) ---
RUN_BUDGET_USD=0.50
RUN_BUDGET_STEPS=40
RUN_BUDGET_SECONDS=360
